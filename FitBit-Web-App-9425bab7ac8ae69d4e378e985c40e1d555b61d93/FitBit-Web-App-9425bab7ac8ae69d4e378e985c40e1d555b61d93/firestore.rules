rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'nalamatlhakwana@gmail.com'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'fullName', 'email', 'role', 'createdAt']) &&
             data.keys().size() <= 10 &&
             isValidId(data.userId) &&
             data.userId == (resource == null ? request.auth.uid : existing().userId) &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['member', 'admin', 'trainer'] &&
             (resource == null ? data.createdAt == request.time : data.createdAt == existing().createdAt);
    }

    function isValidMembership(data) {
      return data.keys().hasAll(['userId', 'planType', 'status', 'updatedAt']) &&
             data.keys().size() <= 7 &&
             isValidId(data.userId) &&
             data.planType in ['monthly', 'quarterly', 'annual'] &&
             data.status in ['pending', 'active', 'expired', 'cancelled'] &&
             data.updatedAt == request.time;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'amount', 'planType', 'paymentDate', 'status']) &&
             data.keys().size() == 5 &&
             data.userId == request.auth.uid &&
             data.amount is number && data.amount > 0 &&
             data.paymentDate == request.time &&
             data.status is string && data.status.size() <= 50;
    }

    function isValidTrainer(data) {
      return data.keys().hasAll(['name', 'specialization', 'bio', 'photoUrl']) &&
             data.keys().size() <= 6 &&
             data.name is string && data.name.size() <= 100 &&
             data.specialization is string && data.specialization.size() <= 200 &&
             data.bio is string && data.bio.size() <= 2000 &&
             data.photoUrl is string && data.photoUrl.size() <= 500;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['memberId', 'trainerId', 'date', 'time', 'status']) &&
             data.keys().size() == 5 &&
             data.memberId == request.auth.uid &&
             isValidId(data.trainerId) &&
             data.date is string && data.date.size() <= 50 &&
             data.time is string && data.time.size() <= 50 &&
             data.status in ['scheduled', 'completed', 'cancelled'];
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.message is string && data.message.size() <= 2000 &&
             data.createdAt == request.time;
    }

    // --- Match Groups ---

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(incoming()) && incoming().role == 'member';
      allow update: if isAdmin() || (isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phoneNumber', 'profilePicture', 'medicalClearance']));
      allow delete: if isAdmin();
    }

    match /memberships/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isOwner(userId) && isEmailVerified() && isValidMembership(incoming()) && incoming().status == 'pending';
      allow update: if (isAdmin() && isValidMembership(incoming())) || 
                    (isOwner(userId) && isValidMembership(incoming()) && 
                     incoming().diff(existing()).affectedKeys().hasOnly(['status', 'planType', 'updatedAt']) &&
                     existing().status == 'pending' && incoming().status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isEmailVerified() && isValidPayment(incoming());
      allow update, delete: if isAdmin();
    }

    match /trainers/{trainerId} {
      allow read: if isValidId(trainerId) && isSignedIn();
      allow write: if isAdmin() && isValidTrainer(incoming());
    }

    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && (isOwner(existing().memberId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && (resource.data.memberId == request.auth.uid || resource.data.trainerId == request.auth.uid));
      allow create: if isSignedIn() && isEmailVerified() && isValidAppointment(incoming()) && 
                    exists(/databases/$(database)/documents/trainers/$(incoming().trainerId));
      allow update: if (isAdmin() && isValidAppointment(incoming())) || 
                    (isOwner(existing().memberId) && isValidAppointment(incoming()) && 
                     incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                     incoming().status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if isValidContactMessage(incoming()); 
      allow list, get, update, delete: if isAdmin();
    }
  }
}
